[Unit]
Description=Hermes child agent trollbox
After=network-online.target hermes-fleet-controller.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=180
ExecStartPre=-/usr/bin/podman rm -f hermes-trollbox
ExecStart=/usr/bin/podman run --name hermes-trollbox \
  --memory 500m \
  --env-file /opt/fleet/agents/trollbox/.env \
  -e HERMES_AGENT_NAME=trollbox \
  -v /opt/fleet/agents/trollbox:/opt/data:Z \
  -v /opt/fleet/skills:/opt/fleet/skills:ro,Z \
  -v /opt/fleet/patches/run_inbound.py:/opt/hermes/gateway/run_inbound.py:ro,Z \
  -p 127.0.0.1:8644:8642 \
  docker.io/nousresearch/hermes-agent:latest hermes gateway run
ExecStop=/usr/bin/podman stop -t 10 hermes-trollbox
ExecStopPost=-/usr/bin/podman rm -f hermes-trollbox

[Install]
WantedBy=multi-user.target
