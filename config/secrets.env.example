# /opt/fleet/secrets.env (mode 0600 root:root)
# Copy this file to /opt/fleet/secrets.env and replace placeholders.

VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1
TELEGRAM_BOT_NAME=YourBotUsername
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ALLOWED_USERS=1234567890       # numeric Telegram user id(s), comma-separated — REQUIRED
CONTROLLER_MODEL=kimi-k3
FLEET_DIR=/opt/fleet
INVENTORY_FILE=/opt/fleet/inventory.yaml
CHANGELOG_FILE=/opt/fleet/changelog.jsonl
